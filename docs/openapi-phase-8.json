{
  "openapi": "3.0.3",
  "info": {
    "title": "Person Search Phase 8 API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/admin/system-status": {
      "get": {
        "summary": "Camera, worker, storage and encoder status",
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/diagnostics/camera-pipeline": {
      "post": {
        "summary": "Run frame source, detector, tracker and image encoder checks for one camera",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "camera_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "camera_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diagnostic report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosticReport"
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "camera_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "validation_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/diagnostics/search-components": {
      "post": {
        "summary": "Check active encoder config, text and image encoder, storage",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Diagnostic report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosticReport"
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/audit-logs": {
      "get": {
        "summary": "Search audit log",
        "parameters": [
          {
            "name": "occurred_from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "occurred_to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "actor_user_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "event_type",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Repeatable, e.g. case.created"
          },
          {
            "name": "result",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "SUCCESS",
                "FAILURE"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "next_cursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AuditLog"
                      }
                    },
                    "next_cursor": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "validation_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/audit-logs/actors": {
      "get": {
        "summary": "Users that appear as actor in the audit log",
        "responses": {
          "200": {
            "description": "Actors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "username": {
                            "type": "string"
                          },
                          "display_name": {
                            "type": "string"
                          },
                          "role": {
                            "type": "string",
                            "enum": [
                              "ADMIN",
                              "OPERATOR",
                              "VIEWER"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ps_session"
      }
    },
    "schemas": {
      "SystemStatus": {
        "type": "object",
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "object",
            "properties": {
              "healthy": {
                "type": "integer"
              },
              "connection_issues": {
                "type": "integer"
              },
              "ai_issues": {
                "type": "integer"
              },
              "unknown": {
                "type": "integer"
              }
            }
          },
          "cameras": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CameraStatus"
            }
          },
          "storage": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "UP",
                "DOWN"
              ]
            }
          },
          "encoder": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ]
          },
          "worker": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "IDLE",
                  "RUNNING",
                  "ERROR"
                ]
              },
              "queue_depth": {
                "type": "integer"
              },
              "last_heartbeat_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              }
            }
          }
        }
      },
      "CameraStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "area_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          },
          "connection": {
            "type": "string",
            "enum": [
              "ONLINE",
              "OFFLINE",
              "ERROR",
              "UNKNOWN",
              "NOT_CONFIGURED"
            ]
          },
          "last_checked_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ai_enabled": {
            "type": "boolean"
          },
          "worker_state": {
            "type": "string",
            "enum": [
              "IDLE",
              "QUEUED",
              "RUNNING",
              "ERROR",
              "DISABLED"
            ]
          },
          "active_job_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "last_heartbeat_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "last_error": {
            "type": "string",
            "nullable": true,
            "description": "Stage code, e.g. detector_failed, worker_heartbeat_lost"
          },
          "metrics": {
            "type": "object",
            "description": "Always null until workers report metrics",
            "properties": {
              "source_fps": {
                "type": "number",
                "nullable": true
              },
              "processed_fps": {
                "type": "number",
                "nullable": true
              },
              "latency_ms": {
                "type": "number",
                "nullable": true
              }
            }
          },
          "category": {
            "type": "string",
            "enum": [
              "healthy",
              "connection_issues",
              "ai_issues",
              "unknown"
            ]
          }
        }
      },
      "DiagnosticReport": {
        "type": "object",
        "properties": {
          "ran_at": {
            "type": "string",
            "format": "date-time"
          },
          "overall": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "INCONCLUSIVE",
              "FAILED"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "component": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "SUCCESS",
                    "INCONCLUSIVE",
                    "FAILED",
                    "SKIPPED"
                  ]
                },
                "message": {
                  "type": "string",
                  "nullable": true
                },
                "duration_ms": {
                  "type": "integer",
                  "nullable": true
                }
              }
            }
          }
        }
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "object",
            "nullable": true,
            "description": "null = system",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "username": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "event_type": {
            "type": "string"
          },
          "target_type": {
            "type": "string"
          },
          "target_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "target_label": {
            "type": "string",
            "nullable": true,
            "description": "Current camera name, username, Case title or config name"
          },
          "result": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "FAILURE"
            ]
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
