# Flask development server only. Do not commit real secrets.
PERSON_SEARCH_ENV=development
PERSON_SEARCH_HOST=127.0.0.1
PERSON_SEARCH_PORT=5000
PERSON_SEARCH_DEBUG=false

# Storage configuration. Keep credentials aligned with your local infra/.env.
PERSON_SEARCH_POSTGRES_DSN=postgresql+psycopg://person_search:dev-postgres-change-me@127.0.0.1:5432/person_search
PERSON_SEARCH_POSTGRES_POOL_SIZE=5
PERSON_SEARCH_POSTGRES_MAX_OVERFLOW=5
PERSON_SEARCH_POSTGRES_POOL_TIMEOUT_SECONDS=10
PERSON_SEARCH_POSTGRES_CONNECT_TIMEOUT_SECONDS=3

PERSON_SEARCH_MILVUS_URI=http://127.0.0.1:19530
PERSON_SEARCH_MILVUS_DATABASE=default
PERSON_SEARCH_MILVUS_TIMEOUT_SECONDS=3

PERSON_SEARCH_MINIO_ENDPOINT=127.0.0.1:9000
PERSON_SEARCH_MINIO_ACCESS_KEY=person-search-app
PERSON_SEARCH_MINIO_SECRET_KEY=dev-minio-app-change-me
PERSON_SEARCH_MINIO_BUCKET=person-search-frames
PERSON_SEARCH_MINIO_SECURE=false
PERSON_SEARCH_MINIO_TIMEOUT_SECONDS=3

# Phase 3 camera management: Fernet key (keep stable; inject via secret manager).
PERSON_SEARCH_RTSP_KEY=
# Explicit camera subnets. Tests accept literal IPs only; loopback/link-local denied.
PERSON_SEARCH_RTSP_NETWORKS=10.0.1.0/24
# Absolute path to a trusted JSON model registry; empty = no registered models.
PERSON_SEARCH_MODEL_REGISTRY=
# Optional absolute local artifact root; defaults to the registry file's directory.
PERSON_SEARCH_MODEL_ARTIFACT_ROOT=
# Demo registry needs this local-development flag and is always rejected in production.
PERSON_SEARCH_ALLOW_DEMO_MODELS=0
# Deployment-owned worker resource profile. Use colab_t4 only inside the T4 runtime.
PERSON_SEARCH_AI_RESOURCE_CONFIG=config/ai_resources.json
PERSON_SEARCH_AI_RESOURCE_PROFILE=local_cpu

# Phase 4: absolute shared private directory for Flask and the worker.
PERSON_SEARCH_VIDEO_STAGING=var/videos
PERSON_SEARCH_VIDEO_MAX_BYTES=524288000
PERSON_SEARCH_VIDEO_RESERVE_BYTES=1073741824
# Supervisor kills stuck jobs at this deadline; a lease permits safe retry (max 3 attempts).
PERSON_SEARCH_JOB_TIMEOUT_SECONDS=3600
PERSON_SEARCH_WORKER_HEARTBEAT_SECONDS=10
PERSON_SEARCH_WORKER_METRICS_SECONDS=2
PERSON_SEARCH_DIAGNOSTIC_TIMEOUT_SECONDS=180
PERSON_SEARCH_DIAGNOSTIC_VIDEO=
# Production worker adapter configuration. The worker fails closed before AIW-18
# publication is connected; it never marks a processed job SUCCEEDED prematurely.
PERSON_SEARCH_DETECTOR_CONFIG=config/ultralytics_yolo_detector.json
PERSON_SEARCH_SELECTOR_CONFIG=config/representative_selector.json
PERSON_SEARCH_RASA_CONFIG=config/rasa_cuhk_pedes_runtime.json

PERSON_SEARCH_CORS_ORIGINS=
