# Local development values only. Replace every password before shared deployment.
POSTGRES_DB=person_search
POSTGRES_USER=person_search
POSTGRES_PASSWORD=dev-postgres-change-me
POSTGRES_PORT=5432

# Root credentials are reserved for MinIO administration and Milvus internals.
MINIO_ROOT_USER=person-search-minio-root
MINIO_ROOT_PASSWORD=dev-minio-root-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# The backend uses this least-privilege account for person-search-frames only.
MINIO_APP_ACCESS_KEY=person-search-app
MINIO_APP_SECRET_KEY=dev-minio-app-change-me

MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091

# Optional AIW-09 RTSP fixture. Keep loopback unless testing from an allowlisted LAN address.
MEDIAMTX_BIND_ADDRESS=127.0.0.1
MEDIAMTX_RTSP_PORT=8554
